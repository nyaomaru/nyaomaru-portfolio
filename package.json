{
  "name": "nyaomaru-portfolio",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint --no-warn-ignored .",
    "prepare": "lefthook install",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fmt": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore .",
    "fmt:check": "oxfmt --check --ignore-path .gitignore --ignore-path .oxfmtignore ."
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.1",
